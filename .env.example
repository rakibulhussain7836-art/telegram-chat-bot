# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# SQLite file that stores users, coins, referrals and reports.
# Leave unset to use ./bot.db (works locally).
# On Koyeb: mount a Persistent Volume and point this at it, e.g.
#   DB_PATH=/data/bot.db   → data survives redeploys.
# Use DB_PATH="" to disable persistence (memory only, for tests).
DB_PATH=bot.db

# Your own Telegram user ID — reviews 🪩 verification photo requests
# (find it by messaging @userinfobot). Leave empty to disable the
# /verifylist, /verifyok and /verifyno admin commands.
ADMIN_ID=

# Forced channel subscription — users must join this channel before
# they can use the bot (they get a join popup on /start and on every
# button press until they join). Use @channelusername or channelusername.
# Leave empty to disable the force-join gate entirely.
FORCE_CHANNEL=@yourchannel

# Invite link for PRIVATE channels (https://t.me/+…). Required when
# FORCE_CHANNEL is a private channel id (-100…). Leave empty for public
# channels — the bot builds the t.me link automatically.
FORCE_CHANNEL_INVITE=
