# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# SQLite file that stores users, coins, referrals and reports.
# Leave unset to use ./bot.db (works locally).
#
# ⚠️ Cloud hosts (Koyeb, Render…) ERASE the server disk on every deploy.
# To keep your users/coins/chats across deploys you MUST store the DB on a
# Persistent Volume / Disk:
#   1. Create a volume in your host's dashboard and mount it at /data
#   2. Set DB_PATH=/data/bot.db here (and in the host's env settings)
# On Koyeb: Service → Volumes → create volume, mount at /data.
# On Render:  Service → Disks → add disk, mount at /data.
# Use DB_PATH="" to disable persistence (memory only, for tests).
DB_PATH=bot.db

# Your own Telegram user ID — reviews 🪩 verification photo requests
# (find it by messaging @userinfobot). Leave empty to disable the
# /verifylist, /verifyok and /verifyno admin commands.
ADMIN_ID=

# Forced channel subscription — users must join this channel before
# they can use the bot (they get a join popup on /start and on every
# button press until they join). Use @channelusername or channelusername.
# Leave empty to disable the force-join gate entirely.
#
# IMPORTANT: add your bot to the channel as an ADMINISTRATOR — Telegram
# only lets bots check membership of chats where they are admins.
FORCE_CHANNEL=@yourchannel

# Invite link for PRIVATE channels (https://t.me/+…). Required when
# FORCE_CHANNEL is a private channel id (-100…). Leave empty for public
# channels — the bot builds the t.me link automatically.
FORCE_CHANNEL_INVITE=

# ── Free persistence (survives redeploys on ephemeral free hosts) ──
# Create a PRIVATE channel, add your bot as ADMIN (needs "post messages"
# and "pin messages" rights), and put its @username or -100… id here.
# The bot uploads its database there every BACKUP_INTERVAL seconds — but
# only when the database actually changed since the last upload — and
# restores it automatically on startup. Every new upload replaces (deletes)
# the previous pinned backup, so the channel holds exactly one snapshot.
# Users, coins and chats continue exactly where they stopped, even after a
# full redeploy that wiped the disk.
# Leave empty to disable (local ./bot.db only).
BACKUP_CHANNEL=
BACKUP_INTERVAL=600
