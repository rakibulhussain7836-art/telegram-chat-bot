# Get your bot token from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# SQLite file that stores users, coins, referrals and reports.
# Leave unset to use ./bot.db (works locally).
# On Koyeb: mount a Persistent Volume and point this at it, e.g.
#   DB_PATH=/data/bot.db   → data survives redeploys.
# Use DB_PATH="" to disable persistence (memory only, for tests).
DB_PATH=bot.db
